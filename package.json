{
  "name": "bigeon",
  "version": "0.1.0",
  "description": "A carrier pigeon for code. A strong model hands tasks to a cheap worker model through git and gets back short PASS/FAIL notes.",
  "type": "module",
  "bin": {
    "bigeon": "bin/bigeon.ts"
  },
  "scripts": {
    "test": "node --test \"test/*.test.*\"",
    "typecheck": "tsc -p tsconfig.json",
    "verify": "npm run typecheck && npm test"
  },
  "engines": {
    "node": ">=22.18"
  },
  "license": "MIT",
  "keywords": [
    "agents",
    "claude",
    "git",
    "llm",
    "orchestration",
    "local-models"
  ],
  "devDependencies": {
    "@types/node": "24.19.1",
    "typescript": "7.0.2"
  }
}
